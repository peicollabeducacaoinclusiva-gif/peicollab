# ============================================================================
# PEI COLLAB - CONFIGURACOES DE AMBIENTE (DESENVOLVIMENTO)
# ============================================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commitar arquivos .env com segredos.
# ============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[seu-project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui

# Backend/servidor apenas (nunca no frontend)
SERVICE_SECRET_KEY=sua_secret_key_aqui
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[project-ref].supabase.co:5432/postgres

# OpenAI (usar apenas em Edge Functions/servidor)
OPENAI_API_KEY=sua_openai_api_key_aqui

# VAPID (notificacoes push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# URLs do app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=https://[seu-project-ref].supabase.co

# Flags
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_OFFLINE_MODE=false
