# ============================================================================
# PEI COLLAB - CONFIGURAÇÕES DE AMBIENTE (PRODUÇÃO)
# ============================================================================
# ⚠️ IMPORTANTE: NUNCA commite o arquivo .env no git
# ============================================================================
# Copie este arquivo para .env.local e preencha com os valores reais
# ============================================================================

# ============================================================================
# SUPABASE - Configuracoes do Banco de Dados
# ============================================================================
# Obtenha estes valores em: https://app.supabase.com/project/[seu-projeto]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[seu-project-ref].supabase.co

# ============================================================================
# 🔐 CHAVES DO SUPABASE - NOVA ARQUITETURA DE SEGURANÇA
# ============================================================================
# A antiga anon key foi vazada e revogada. Agora usamos:
# - Chave Pública (Frontend): Pode ser exposta
# - Chave Secreta (Backend): NUNCA no frontend!
# ============================================================================

# Chave Publica (Publishable Key) - ✅ USAR NO FRONTEND
# Substitui a antiga ANON KEY (revogada)
# Pode ser exposta no código do cliente (está no bundle JavaScript)
# Obtenha em: https://app.supabase.com/project/[seu-projeto]/settings/api
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui

# ⚠️ Chave Secreta (Secret Key) - 🔒 APENAS NO BACKEND
# Substitui a antiga SUPABASE_SERVICE_ROLE_KEY (desabilitada, mas não pode ser deletada)
# ⚠️ IMPORTANTE: Nome deve ser SERVICE_SECRET_KEY (sem prefixo SUPABASE_ que é reservado)
# Use APENAS em:
#   - Edge Functions do Supabase (configure como secret no dashboard com nome "SERVICE_SECRET_KEY")
#   - Scripts Node.js no servidor
#   - Operações administrativas
# NUNCA no frontend! NUNCA no código do cliente!
# Obtenha em: https://app.supabase.com/project/[seu-projeto]/settings/api
# Configure no Supabase Dashboard: Edge Functions > Secrets > Add secret "SERVICE_SECRET_KEY"
SERVICE_SECRET_KEY=sua_secret_key_aqui

# ⚠️ COMPATIBILIDADE TEMPORARIA (sera removido)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui  # ❌ Revogada - nao usar mais
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui  # ❌ Deprecated - use SUPABASE_SECRET_KEY

# ============================================================================
# DATABASE - URL de conexão para scripts de migração
# ============================================================================
# Formato: postgresql://postgres:[SENHA]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[project-ref].supabase.co:5432/postgres

# ============================================================================
# OPENAI - Configuracao da API para geracao de conteudo com IA
# ============================================================================
# ⚠️ SENSÍVEL - Obtenha em: https://platform.openai.com/api-keys
# Para Edge Functions, configure como secret no Supabase Dashboard
OPENAI_API_KEY=sua_openai_api_key_aqui

# S3 Storage (Supabase Storage)
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_REGION=us-east-1
S3_ENDPOINT=https://fximylewmvsllkdczovj.supabase.co/storage/v1/s3

# VAPID Keys (para notificacoes push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Application URLs
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://[seu-project-ref].supabase.co

# Production flags
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_OFFLINE_MODE=false
